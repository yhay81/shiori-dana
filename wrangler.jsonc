{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiori-dana",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shiori-dana.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["17 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiori-dana",
      "database_id": "6d133d4b-b193-45bd-a9e9-4e0d09f0c624",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
